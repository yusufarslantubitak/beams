FROM node:22-alpine

WORKDIR /app

# Copy dependency specifications
COPY package.json package-lock.json ./

# Copy pre-installed node_modules and cache a backup copy in /opt/node_modules
COPY node_modules ./node_modules
RUN cp -r /app/node_modules /opt/node_modules

# Copy source code and config
COPY . .

# Expose Vite dev server and GeoJSON backend
EXPOSE 5173 8006

# Ensure node_modules exists when volume is mounted, then launch backend + dev server
CMD ["sh", "-c", "if [ ! -d /app/node_modules ] || [ -z \"$(ls -A /app/node_modules 2>/dev/null)\" ]; then cp -r /opt/node_modules /app/node_modules; fi; node backend.js & npm run dev"]
